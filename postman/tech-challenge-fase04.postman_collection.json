                ]
              }
            }
          ]
        },
        {
          "name": "Erro - campo nota ausente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Esqueci de mandar a nota\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{api_base_url}}/avaliacao"
          },
          "event": [
