                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Mensagem cita o limite de caracteres', function () {",
                  "    pm.expect(pm.response.json().mensagem).to.include('1000');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro - corpo vazio",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "" },
            "url": "{{api_base_url}}/avaliacao"
          },
          "event": [
            {
              "listen": "test",
