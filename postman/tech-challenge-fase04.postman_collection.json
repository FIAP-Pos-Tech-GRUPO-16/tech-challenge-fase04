    {
      "name": "02 - Notificar Urgência (Lambda direto, AWS SigV4)",
      "description": "Função acionada normalmente pelo EventBridge, não por HTTP público. Invocada aqui diretamente via API de Invoke do Lambda (assinatura AWS Signature v4) para permitir testar 100% do projeto a partir desta collection. Preencha aws_access_key_id / aws_secret_access_key / aws_session_token no environment antes de rodar (ver postman/README.md).",
      "auth": {
        "type": "awsv4",
        "awsv4": [
          { "key": "accessKey", "value": "{{aws_access_key_id}}", "type": "string" },
          { "key": "secretKey", "value": "{{aws_secret_access_key}}", "type": "string" },
          { "key": "sessionToken", "value": "{{aws_session_token}}", "type": "string" },
          { "key": "region", "value": "{{aws_region}}", "type": "string" },
          { "key": "service", "value": "lambda", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Invocar com evento de urgência ALTA",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"0\",\n  \"id\": \"evento-teste-postman\",\n  \"detail-type\": \"AvaliacaoRecebida\",\n  \"source\": \"tech-challenge.feedback\",\n  \"account\": \"827938108008\",\n  \"time\": \"2026-01-10T10:00:00Z\",\n  \"region\": \"{{aws_region}}\",\n  \"resources\": [],\n  \"detail\": {\n    \"id\": \"11111111-1111-1111-1111-111111111111\",\n    \"descricao\": \"Teste manual via Postman - aula com problema grave\",\n    \"nota\": 1,\n    \"nivelUrgencia\": \"ALTA\",\n    \"dataEnvio\": \"2026-01-10T10:00:00Z\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "https://lambda.{{aws_region}}.amazonaws.com/2015-03-31/functions/{{function_notificar_urgencia}}/invocations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invocação aceita pelo Lambda (HTTP 200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Função executou sem erro (sem X-Amz-Function-Error)', function () {",
                  "    pm.expect(pm.response.headers.get('X-Amz-Function-Error')).to.be.null;",
                  "});",
                  "pm.test('Resposta confirma processamento', function () {",
                  "    pm.expect(pm.response.text()).to.include('Avaliação processada');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invocar com evento malformado (espera erro controlado)",
          "description": "Confirma que a função rejeita evento sem o campo 'detail' em vez de falhar silenciosamente — a exceção propositalmente não é capturada no handler, para acionar o retry/DLQ do EventBridge em produção.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "https://lambda.{{aws_region}}.amazonaws.com/2015-03-31/functions/{{function_notificar_urgencia}}/invocations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invocação aceita pelo Lambda (HTTP 200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Função reporta erro (evento inválido)', function () {",
                  "    pm.expect(pm.response.headers.get('X-Amz-Function-Error')).to.eql('Unhandled');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Gerar Relatório Semanal (Lambda direto, AWS SigV4)",
      "description": "Função acionada normalmente pelo EventBridge Scheduler (toda segunda-feira). Invocada aqui diretamente para não precisar esperar o agendamento.",
      "auth": {
        "type": "awsv4",
        "awsv4": [
          { "key": "accessKey", "value": "{{aws_access_key_id}}", "type": "string" },
          { "key": "secretKey", "value": "{{aws_secret_access_key}}", "type": "string" },
          { "key": "sessionToken", "value": "{{aws_session_token}}", "type": "string" },
          { "key": "region", "value": "{{aws_region}}", "type": "string" },
          { "key": "service", "value": "lambda", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Invocar geração do relatório semanal",
          "description": "Dispara a agregação das avaliações dos últimos 7 dias e o envio do relatório por e-mail para o administrador.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "https://lambda.{{aws_region}}.amazonaws.com/2015-03-31/functions/{{function_gerar_relatorio_semanal}}/invocations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invocação aceita pelo Lambda (HTTP 200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Função executou sem erro (sem X-Amz-Function-Error)', function () {",
                  "    pm.expect(pm.response.headers.get('X-Amz-Function-Error')).to.be.null;",
                  "});",
                  "pm.test('Resposta confirma envio do relatório', function () {",
                  "    pm.expect(pm.response.text()).to.include('Relatório');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
