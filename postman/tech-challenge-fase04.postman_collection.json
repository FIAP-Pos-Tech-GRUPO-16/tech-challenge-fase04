{
  "info": {
    "name": "Tech Challenge Fase 4 - Plataforma de Feedback de Aulas",
    "description": "Collection completa para testar os 3 componentes serverless do projeto: o endpoint HTTP público (receber-avaliacao, via API Gateway) e as duas funções acionadas por evento/agendamento (notificar-urgencia e gerar-relatorio-semanal), invocadas diretamente via API de Invoke do Lambda com autenticação AWS Signature v4. Ver postman/README.md para instruções de uso.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "01 - Receber Avaliação (API Gateway)",
      "description": "Endpoint público POST /avaliacao. Não exige autenticação (por desenho — ver docs/arquitetura.md).",
      "item": [
        {
          "name": "Avaliação válida - urgência BAIXA (nota 8)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Aula excelente, professor muito didático\",\n  \"nota\": 8\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{api_base_url}}/avaliacao"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Resposta contém id e nivelUrgencia', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body).to.have.property('nivelUrgencia');",
                  "});",
                  "pm.test('Nível de urgência é BAIXA', function () {",
                  "    pm.expect(pm.response.json().nivelUrgencia).to.eql('BAIXA');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Avaliação válida - urgência MÉDIA (nota 5)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Aula ok, mas o ritmo poderia ser melhor\",\n  \"nota\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{api_base_url}}/avaliacao"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Nível de urgência é MEDIA', function () {",
                  "    pm.expect(pm.response.json().nivelUrgencia).to.eql('MEDIA');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Avaliação válida - urgência ALTA / crítica (nota 1)",
          "description": "Essa requisição dispara, de forma assíncrona, a função notificar-urgencia (evento roteado pelo EventBridge) — um e-mail de alerta deve chegar para o administrador em alguns segundos.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Aula com problemas graves de áudio, ninguém conseguiu acompanhar\",\n  \"nota\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{api_base_url}}/avaliacao"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Nível de urgência é ALTA', function () {",
                  "    pm.expect(pm.response.json().nivelUrgencia).to.eql('ALTA');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro - nota acima do limite (11)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Nota inválida de propósito\",\n  \"nota\": 11\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{api_base_url}}/avaliacao"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Resposta contém mensagem de erro sobre a nota', function () {",
                  "    pm.expect(pm.response.json().mensagem).to.include('Nota');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro - nota abaixo do limite (-1)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Nota inválida de propósito\",\n  \"nota\": -1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{api_base_url}}/avaliacao"
          },
          "event": [
            {
