        },
        {
          "name": "Erro - descrição acima de 1000 caracteres",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"{{descricao_muito_longa}}\",\n  \"nota\": 5\n}",
              "options": { "raw": { "language": "json" } }
